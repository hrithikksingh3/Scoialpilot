{
  "name": "scoialpilot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Cost-conscious social content research and publishing engine for Codersvoice",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "research": "tsx src/research/run.ts",
    "generate-drafts": "tsx src/content/run.ts",
    "list-drafts": "tsx src/content/list-drafts.ts",
    "review-draft": "tsx src/content/review-draft.ts",
    "scheduler-check": "tsx src/content/scheduler.ts",
    "scheduler-mark-run": "tsx src/content/scheduler.ts mark",
    "publish-due": "tsx src/content/publish-due.ts"
  },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.5",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
