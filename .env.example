# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
LOG_LEVEL=info

# AI providers. Paid usage is disabled by default.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ALLOW_PAID_AI=false

# Configure when database integration is implemented.
DATABASE_URL=

# Social credentials — publishing is not implemented yet.
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
